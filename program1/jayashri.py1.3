marks = []
n = int(input("Enter number of subjects: "))
for i in range(n):
    mark = int(input("Enter mark: "))
    marks.append(mark)
total = sum(marks)
average = total / n
if average >= 90:
    grade = "A"
elif average >= 75:
    grade = "B"
elif average >= 50:
    grade = "C"
else:
    grade = "F"
print("Marks:", marks)
print("Total:", total)
print("Average:", average)
print("Grade:", grade)